---
import { site } from "../content/site";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="frame">
    <div class="footer__inner">
      <span>{site.role}, {site.city}</span>
      <nav class="footer__links" aria-label="Elsewhere">
        <a href={`mailto:${site.email}`}>Email</a>
        <a href={site.linkedin} data-umami-event="linkedin">LinkedIn</a>
        <a href={site.github} data-umami-event="github">GitHub</a>
      </nav>
      <span class="footer__year">{year}</span>
    </div>
  </div>
</footer>
