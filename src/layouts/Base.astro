---
import "@fontsource/jost/latin-400.css";
import "@fontsource/jost/latin-500.css";
import "@fontsource/jost/latin-700.css";
import "@fontsource/jost/latin-400-italic.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/sections.css";
import "../styles/fragments.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;

// Umami, self-hosted on the homelab. Both vars must be set or nothing ships.
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC;
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const analytics = Boolean(umamiSrc && umamiWebsiteId);

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Marco Pianaroli",
  jobTitle: "IT Support & Systems Administrator",
  url: Astro.site?.href,
  email: "mailto:me@marcopianaroli.com",
  description,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Berlin",
    addressCountry: "DE",
  },
  knowsLanguage: ["es", "en", "de"],
  knowsAbout: [
    "IT support",
    "Systems administration",
    "Linux",
    "Docker",
    "DNS",
    "Networking",
    "Active Directory",
  ],
  sameAs: [
    "https://www.linkedin.com/in/marco-pianaroli96/",
    "https://github.com/marcop96",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b1a13" />
    <meta
      name="robots"
      content={noindex
        ? "noindex, follow"
        : "index, follow, max-image-preview:large"}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Marco Pianaroli" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="I'm the IT department. Marco Pianaroli, IT support and systems admin in Berlin." />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />

    {
      analytics && (
        <script
          is:inline
          defer
          src={umamiSrc}
          data-website-id={umamiWebsiteId}
        />
      )
    }

    <script is:inline>
      // Runs before paint so the entrance never flashes content in and out.
      (function () {
        var reduce = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        if (!reduce) document.documentElement.classList.add("js");
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
